addCircleMarkers(data = chem, lng = ~ chem$x, lat = ~chem$y, color = ~pal.ec(chem$ec), weight = 2.5, options = pathOptions(pane = "data_ec"), group = "ec", fillOpacity = 1) |>
addLegend(pal = pal.ec, values = chem$ec, title = "Electrical conductivity", position = 'topright', group = "ec", opacity = 1, na.label = "NA") |>
## ec
addCircleMarkers(data = chem, lng = ~ chem$x, lat = ~chem$y, color = ~pal.ds(chem$dissolved_solids_ppm), weight = 2.5, options = pathOptions(pane = "data_ds"), group = "ds", fillOpacity = 1) |>
addLegend(pal = pal.ds, values = chem$dissolved_solids_ppm, title = "Dissolved Solids", position = 'topright', group = "ds", opacity = 1, na.label = "NA") |>
hideGroup("pH") |>
# ability to choose which layers to see
addGroupedLayersControl(
baseGroups = c("Satellite", "Topographic", "White & Grey"),
overlayGroups = list(
"Water chemistry data" = c("pH", "ec", "ds")),
position = "topleft",
options = groupedLayersControlOptions(
groupCheckboxes = FALSE,
collapsed = FALSE,
groupsCollapsable = FALSE,
sortLayers = FALSE,
sortGroups = FALSE,
sortBaseLayers = FALSE,
exclusiveGroups = c("Water chemistry data"),
)
)
exploits_map_chem
